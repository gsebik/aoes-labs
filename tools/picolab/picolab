  terminal 1:  picolab ocd       OpenOCD stays connected to the chip; its log shows every
                                 flash, GDB connection and error, live.  If a server is
                                 already running it offers to replace it here (--force: do
                                 it without asking)
  terminal 2:  picolab flash / picolab debug   these find the server and go through it

${C_BOLD}More${C_OFF}
  picolab list          course lab targets it can find      picolab build-all   compile-check them all
  picolab load x.elf    flash a prebuilt image, then monitor
  picolab doctor --fix  offer each known fix, and ask before running it (builds/links picotool
                        and OpenOCD too)
  picolab upgrade [ver] opt in to a newer Pico SDK than the course pin (default: latest);
                        --tools also refreshes picotool/OpenOCD. The pin stays the default.
  picolab doctor --fix --yes    run every fix without asking (fresh machine / CI)
  picolab doctor --fix --all    provision everything, probe or not: OpenOCD (Debug Probe),
                                the FreeRTOS kernel and the PicoGremlin LA tools; picotool
                                when no probe is attached (probe-free flashing — setup §5)
  picolab install --tools --all --yes   one shot, no prompts: link picolab + whole toolchain
  picolab help env      settings: PICO_SDK_PATH, ADAPTER_SPEED, SERIAL, ...

${C_BOLD}Learn what it does${C_OFF}
  picolab explain [topic]   the whole pipeline with YOUR project's real commands, every flag
                            explained — runs nothing (topics: configure build flash debug ocd monitor)
  picolab flash --step      do it for real, but stop before each tool command: explain it, ask, run
                            (works with build, flash, debug, ocd, monitor, load)

Every "\$ ..." line it prints is the real command: copy it and run it by hand any time.
EOF
}

usage_env() {
    cat <<EOF
${C_BOLD}picolab settings${C_OFF} — environment variables (make one permanent: add the export line to ~/.bashrc)

  PICO_SDK_PATH         REQUIRED to build: your Pico SDK checkout.
                          export PICO_SDK_PATH=\$HOME/pico-sdk      (picolab doctor --fix can clone it)
  FREERTOS_KERNEL_PATH  For the RTOS labs (AoES L5, EOS): a FreeRTOS-Kernel checkout, unless the
                        course repo has lib/FreeRTOS-Kernel as a submodule. The course pins
                        V11.3.1; picolab doctor reads include/task.h and fails on any other
                        revision, because the firmware prints it and the images are compared
                        against it.
  FREERTOS_KERNEL_VERSION
                        The revision picolab installs and requires (default: 11.3.1; a
                        leading V is optional). Set it only when a lab genuinely pins a
                        different kernel. doctor --fix installs into
                        ~/.pico-sdk/freertos/FreeRTOS-Kernel-<version>, so two revisions
                        can coexist, and the firmware prints whichever was used.
  PICO_BOARD            Board type (default: pico2_w).
  SERIAL                Serial device for monitor (default: auto-detect the probe's UART bridge).
  ADAPTER_SPEED         SWD clock in kHz (default: 2000). Lower it (1000) if flashing fails with
                        "CMSIS-DAP command mismatch"; raise it if your probe is happy.
  CMSIS_DAP_QUIRK       1 (default) = one USB request to the probe at a time: slower, but the
                        course probe firmware needs it. 0 = OpenOCD's faster pipelined mode.
  PICOLAB_LABS          Colon-separated folders holding course labs (default: every src/<course>/
                        in this repo that contains Pico projects).
  PICOLAB_ENV           where install/upgrade record PICO_SDK_PATH etc.
                        (default: ~/.config/picolab/env). picolab sources it automatically, so an
                        upgrade applies on the NEXT picolab command — no shell restart.
  PICOLAB_NO_ENV        1 = ignore that env file for a one-off run.
  PICOLAB_SDK_VERSION   SDK release doctor --fix clones when there is none (default: $SDK_VERSION).
  PICOLAB_PICOTOOL_VERSION  picotool release to build when no SDK says which (default: $PICOTOOL_VERSION).
  PICOLAB_LA            Path to the 'la' CLI (the logic analyzer), if not on PATH or in
                        ~/.local/share/picogremlin/venv.
  PICOGREMLIN_LA_SRC    picogremlin-la checkout whose install.sh doctor --fix should run
                        (default: a sibling checkout, else the published installer).
  NO_COLOR=1            Plain output, no colours.

Build-time #defines: trailing KEY=VAL args become -DKEY=VAL, e.g.
  picolab flash l4_optimize START_MODE=1 LCD_MHZ=75
EOF
}

# One dim line per step saying what is happening underneath — show() prints the
# commands; this says what they DO, so the tool teaches instead of hiding.
explain() { [ "$STEP" = 1 ] && return 0; printf '%s   what happens: %s%s\n' "$C_DIM" "$*" "$C_OFF"; }

# Split remaining args into KEY=VAL build overrides (forwarded as -D...) and
# positional args, e.g.  picolab flash l4_optimize START_MODE=1 ENABLE_DBUF=0
defs=(); pos=(); known="$(known_knobs)"
for a in "$@"; do
    case "$a" in
        --no-build)   NOBUILD=1 ;;
        --no-break)   NOBREAK=1 ;;
        --direct|--uf2|--picotool) PROBE_FREE=1 ;;
        --tools)      INSTALL_TOOLS=1 ;;
        --bridge)     INSTALL_BRIDGE=1 ;;
        --yes|-y)     YES=1 ;;
        --all)        ALL=1 ;;
        --force)      FORCE=1 ;;
        --tui)        DEBUG_UI=tui ;;
        --debug-build) export PICOLAB_BUILD_TYPE=Debug ;;
        --release-build) export PICOLAB_BUILD_TYPE=Release ;;
        --dashboard)  DEBUG_UI=dashboard ;;
        -v|--verbose) VERBOSE=1 ;;
        --step) if [ "$cmd" = init ] || [ "$cmd" = new ]; then pos+=("$a"); else STEP=1; fi ;;
        *=*)
            key="${a%%=*}"
            if ! printf '%s\n' "$known" | grep -qx "$key"; then
                echo "!! unknown build knob '$key' — likely a typo, so it will do NOTHING." >&2
                echo "   Recognised knobs: $(printf '%s ' $known)" >&2
            fi
            defs+=("-D$a")
            ;;
        *)   pos+=("$a") ;;
    esac
done

case "$cmd" in
    list)         list_targets ;;
    doctor|check) doctor "${pos[0]:-}" ;;
    build)        build_target "${pos[0]:-}" ;;   # every lab at once is `build-all`, on purpose not the default
    build-all)    build_all ;;
    flash)        flash_target "${pos[0]:-}" ;;
    load)         load_image "${pos[0]:-}" ;;
    debug)        debug_target "${pos[0]:-}" ;;
    monitor)      monitor "${pos[0]:-}" ;;
    la)           la_cmd "${pos[@]}" ;;
    ocd|server)   ocd_server ;;
    init|new)     init_project "${pos[@]}" ;;
    install)      install_cli "${pos[0]:-}" ;;
    upgrade)      upgrade_cmd "${pos[0]:-}" ;;
    uninstall)    uninstall_cli "${pos[0]:-}" ;;
    explain)      explain_cmd "${pos[@]}" ;;
    dashboard)    dashboard_term ;;
    vscode|code)  vscode_setup ;;
    ""|-h|--help|help) if [ "${pos[0]:-}" = env ]; then usage_env; else usage; fi ;;
    *)            flash_target "$cmd"; monitor ;;   # e.g. $ME l4_optimize START_MODE=1
esac
